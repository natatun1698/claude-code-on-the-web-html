# ============================================================
# このファイルを .env という名前でコピーして、値を埋めてください
#   cp .env.example .env
# .env は .gitignore に含まれているので Git にはコミットされません
# ============================================================

# --- Slack 関連(必須) ---
# Slack アプリの Bot User OAuth Token (xoxb- で始まる)
SLACK_BOT_TOKEN=xoxb-your-token-here

# 分析対象のチャンネルID(省略時は CBHRRSZAP)
SLACK_CHANNEL_ID=CBHRRSZAP

# --- Gmail メール送信関連(メール送信を使う場合に必須) ---
# 送信元の Gmail アドレス
GMAIL_ADDRESS=your-address@gmail.com
# Gmail の「アプリパスワード」(通常のパスワードではありません)
# https://myaccount.google.com/apppasswords で発行できます
GMAIL_APP_PASSWORD=your-app-password
# レポートの送信先メールアドレス(カンマ区切りで複数指定可)
REPORT_TO_EMAIL=recipient@example.com

# --- Notion アップロード関連(Notion 連携を使う場合に必須) ---
# Notion インテグレーションのシークレットトークン (ntn_ / secret_ で始まる)
# https://www.notion.so/my-integrations で作成できます
NOTION_TOKEN=
# レポートページを作成する親ページのID(32桁の英数字)
# ※アップロード先の Notion が決まったらここに設定してください
NOTION_PARENT_PAGE_ID=
