# Slack Bot Token（xoxb- から始まるトークン）
# 取得方法: https://api.slack.com/apps でアプリを作成し、
# OAuth & Permissions > Bot Token Scopes に以下を追加:
#   channels:history, channels:read, reactions:read, users:read
SLACK_BOT_TOKEN=xoxb-your-token-here

# Gmail 送信元アカウント
GMAIL_ADDRESS=your-address@gmail.com

# Gmail アプリパスワード（通常のパスワードではなくアプリ用パスワード）
# 取得方法: Googleアカウント > セキュリティ > 2段階認証を有効化 > アプリパスワード
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# レポート送信先メールアドレス
REPORT_TO_EMAIL=recipient@example.com
